# Production Environment Configuration for Hillview School Management System
# Copy this file to .env.production and customize for your deployment

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your_production_secret_key_here_change_this_to_random_string
WTF_CSRF_SECRET_KEY=your_production_csrf_secret_here_change_this_to_random_string

# Server Configuration
HOST=0.0.0.0
PORT=8443
USE_SSL=true

# SSL Certificate Configuration (optional - will generate self-signed if not provided)
# SSL_CERT_FILE=ssl/cert.pem
# SSL_KEY_FILE=ssl/key.pem

# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production)
# DATABASE_URL=mysql+pymysql://username:password@hostname:port/database_name?charset=utf8mb4

# Option 2: Individual MySQL settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=hillview_user
MYSQL_PASSWORD=your_secure_mysql_password_here
MYSQL_DATABASE=hillview_production

# Redis Configuration (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# Security Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FORCE_HTTPS=true

# Rate Limiting
RATELIMIT_DEFAULT=200 per hour

# Logging
LOG_LEVEL=INFO
ENABLE_JSON_LOGS=false

# Content Security Policy (customize as needed)
# CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests