# Production environment variables for Render
FLASK_ENV=production

# Database - prefer a single hosted DB for both local and Render
# For Aiven MySQL, set DATABASE_URL like:
# DATABASE_URL=mysql+pymysql://USERNAME:URLENCODED_PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
# Tip: URL-encode the password first; see scripts/build_database_url.py

# Security - MUST be changed in production
SECRET_KEY=your-super-secret-key-change-this-in-production
WTF_CSRF_SECRET_KEY=your-csrf-secret-change-this

# Redis (optional - for production scaling)
REDIS_URL=redis://localhost:6379

# Rate limiting (fallback to memory if Redis unavailable)
RATELIMIT_ENABLED=true
ALLOW_IN_MEMORY_LIMITS=true

# Security headers
FORCE_HTTPS=true
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# File uploads
FILE_UPLOAD_MAX_BYTES=5242880
MAX_CONTENT_LENGTH=16777216

# Logging
LOG_LEVEL=INFO

# Application settings
APP_NAME=Hillview School Management System
APP_VERSION=2.0.0

# Optional branding overrides (useful before seeding DB in production)
# SCHOOL_NAME_OVERRIDE=Your School Name
# DEFAULT_LOGO_FILENAME=school_logo.png