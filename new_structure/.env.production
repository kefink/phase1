# Twik School Management System
# Production Deployment Configuration

# Database Configuration
# Prefer a single DATABASE_URL in production. Example format:
# mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://hillview_user:SET_A_STRONG_PASSWORD@localhost:3306/hillview_demo001?charset=utf8mb4

# Security Configuration
# Generate a strong secret (64+ random bytes base64 or hex). Example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET
WTF_CSRF_ENABLED=true
WTF_CSRF_SECRET_KEY=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET

# Flask Environment
FLASK_ENV=production
FLASK_DEBUG=false

# Redis Configuration (for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per hour

# Data Encryption (optional)
ENCRYPTION_ENABLED=false
FERNET_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/twik.log

# Performance
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=3600

# Application Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30