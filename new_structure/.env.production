# Twik School Management System
# Production Deployment Configuration with HTTPS Support

# Server Configuration
HOST=0.0.0.0
PORT=8443
USE_SSL=true

# SSL Certificate Configuration (optional - will generate self-signed if not provided)
# SSL_CERT_FILE=ssl/cert.pem
# SSL_KEY_FILE=ssl/key.pem

# Database Configuration
# For testing, using existing database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hillview_demo001

# Alternative: Use DATABASE_URL for production
# DATABASE_URL=mysql+pymysql://hillview_user:SET_A_STRONG_PASSWORD@localhost:3306/hillview_demo001?charset=utf8mb4

# Security Configuration
# Generate strong secrets using: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=NkKmKoDFhosFEbvsloP1ZrowXUjz-8Sjni0_zDi-liDO_KSYmv4HNGY0V9guLcEtqHuTGAULvBynpoe522yK1g
WTF_CSRF_SECRET_KEY=5mWKTiQ8fuOTjRpfMJT_zyFuDTFCbZCsecIVZsgd2DY-AFYiao2a0bCjMoqd9WY1qt3u4dDjqzgtmBSKd23s1A

# Flask Environment
FLASK_ENV=production
FLASK_DEBUG=false

# HTTPS and Security
FORCE_HTTPS=true
ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443

# Redis Configuration (for rate limiting and caching) - Disable for testing
REDIS_DISABLED=1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per hour

# Data Encryption (optional)
ENCRYPTION_ENABLED=false
FERNET_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/twik.log

# Performance
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=3600

# Application Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30